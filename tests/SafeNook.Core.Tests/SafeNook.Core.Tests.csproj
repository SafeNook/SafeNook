  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SafeNook.Core\SafeNook.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

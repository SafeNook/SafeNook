<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><PublishAot>true</PublishAot></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/SafeNook.Application/SafeNook.Application.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(LibsodiumStaticLib)' != ''"><DirectPInvoke Include="libsodium" /><NativeLibrary Include="$(LibsodiumStaticLib)" /></ItemGroup>
  <Target Name="DropSharedLibsodium" AfterTargets="ResolvePackageAssets" Condition="'$(LibsodiumStaticLib)' != ''">
    <ItemGroup><NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Filename)' == 'libsodium'" /><RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Filename)' == 'libsodium'" /></ItemGroup>
  </Target>
  <ItemGroup><Compile Include="../StoreQualification/GenerationFixture.cs" Link="GenerationFixture.cs" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../DurabilityOracle/DurabilityOracle.csproj" /></ItemGroup>
</Project>

<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup Label="Cryptography">
    <!-- Core Argon2id and F-4 spike; see docs/adr/0002-crypto-library.md -->
    <PackageVersion Include="NSec.Cryptography" Version="26.4.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
